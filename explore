<script>
const SUPABASE_URL = 'https://jhukicslingfrtozebwp.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpodWtpY3NsaW5nZnJ0b3plYndwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAyODYxOTUsImV4cCI6MjA5NTg2MjE5NX0.Xf9QrnDbu7L9yUURp9Yx0_vZFMqHHLY7T4MmB9VFrAQ';
const STORAGE_BUCKET = 'spot-photos';
const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

const CAT_CONFIG = {
  'Cheap Printers':          {emoji:'🖨️',color:'#1E88E5'},
  'Food Stalls':             {emoji:'🍱',color:'#E53935'},
  'Medals & Trophies':       {emoji:'🏆',color:'#F9A825'},
  'Stationery Shops':        {emoji:'✏️',color:'#43A047'},
  'Event Supplies':          {emoji:'🎪',color:'#8E24AA'},
  'Flex & Banner Printing':  {emoji:'🖼️',color:'#00897B'},
  'Photographers & Studios': {emoji:'📸',color:'#FF6B00'},
  'Tailors & Costume Makers':{emoji:'🧵',color:'#D81B60'},
  'Sound & AV Rentals':      {emoji:'🎤',color:'#3949AB'},
  'Transport':               {emoji:'🚐',color:'#6D4C41'},
};

const CITY_COORDS = {
  'Delhi':     [28.6139,77.2090],
  'Kolkata':   [22.5726,88.3639],
  'Pune':      [18.5204,73.8567],
  'Bengaluru': [12.9716,77.5946],
  'Manipal':   [13.3525,74.7868],
};

let map, miniMap, miniMarker;
let allSpots=[], markers=[];
let activeCat='all', pinLat=null, pinLng=null;

function initMap() {
  map = L.map('map',{zoomControl:true}).setView([20.5937,78.9629],5);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(map);
}

function makeIcon(cat) {
  const cfg = CAT_CONFIG[cat]||{emoji:'📍',color:'#FF6B00'};
  return L.divIcon({
    className:'',
    html:`<div class="jugaad-pin" style="background:${cfg.color}"><span>${cfg.emoji}</span></div>`,
    iconSize:[34,34],iconAnchor:[17,34],popupAnchor:[0,-36],
  });
}

function buildPopup(s) {
  const cfg = CAT_CONFIG[s.category]||{emoji:'📍'};
  const photo = s.photo_url
    ? `<div class="popup-photo"><img src="${s.photo_url}" alt="${s.name}"/></div>`
    : `<div class="popup-photo">${cfg.emoji}</div>`;
  return `${photo}<div class="popup-body">
    <div class="popup-cat">${cfg.emoji} ${s.category}</div>
    <div class="popup-name">${s.name}</div>
    <div class="popup-city">📌 ${s.city}</div>
    ${s.address?`<div class="popup-address">📍 ${s.address}</div>`:''}
    ${s.tip?`<div class="popup-tip">💡 ${s.tip}</div>`:''}
  </div>`;
}

function renderMarkers() {
  markers.forEach(m=>map.removeLayer(m));
  markers=[];
  const city = document.getElementById('s-city').value;
  allSpots.filter(s=>{
    const mc = activeCat==='all'||s.category===activeCat;
    const mci = !city||s.city===city;
    return mc&&mci&&s.lat&&s.lng;
  }).forEach(s=>{
    const m = L.marker([s.lat,s.lng],{icon:makeIcon(s.category)})
      .addTo(map).bindPopup(buildPopup(s),{maxWidth:280});
    m.on('mouseover',function(){this.openPopup();});
    m.spotId=s.id;
    markers.push(m);
  });
}

function renderList() {
  const query=(document.getElementById('s-query').value||'').toLowerCase();
  const city=document.getElementById('s-city').value;
  const filtered=allSpots.filter(s=>{
    const mc=activeCat==='all'||s.category===activeCat;
    const mci=!city||s.city===city;
    const mq=!query||s.name.toLowerCase().includes(query)||(s.address||'').toLowerCase().includes(query);
    return mc&&mci&&mq;
  });
  const list=document.getElementById('spots-list');
  document.getElementById('results-count').textContent=`${filtered.length} spot${filtered.length!==1?'s':''} found`;
  if(!filtered.length){
    list.innerHTML=`<div class="no-results"><div class="no-icon">🗺️</div><p>Nothing here yet.<br/>Be the first to submit one!</p></div>`;
    renderMarkers(); return;
  }
  list.innerHTML=filtered.map(s=>{
    const cfg=CAT_CONFIG[s.category]||{emoji:'📍'};
    const thumb=s.photo_url
      ?`<div class="slc-thumb"><img src="${s.photo_url}" alt="${s.name}"/></div>`
      :`<div class="slc-thumb">${cfg.emoji}</div>`;
    return `<div class="spot-list-card" onclick="focusSpot(${s.lat},${s.lng},'${s.id}')">
      ${thumb}
      <div class="slc-info">
        <div class="slc-cat">${s.category}</div>
        <div class="slc-name">${s.name}</div>
        <div class="slc-meta">📌 ${s.city}${s.address?' · '+s.address:''}</div>
        ${s.tip?`<div class="slc-tip">💡 ${s.tip}</div>`:''}
      </div>
    </div>`;
  }).join('');
  renderMarkers();
}

function focusSpot(lat,lng,id) {
  map.setView([lat,lng],16);
  const m=markers.find(m=>m.spotId===id);
  if(m) setTimeout(()=>m.openPopup(),300);
}

function setCat(cat,el) {
  activeCat=cat;
  document.querySelectorAll('#cat-filters .cat-pill').forEach(p=>p.classList.remove('active','active-all'));
  el.classList.add(cat==='all'?'active-all':'active');
  renderList();
}

async function loadSpots() {
  const {data}=await sb.from('spots').select('*').eq('approved',true);
  allSpots=data||[];
  const params=new URLSearchParams(window.location.search);
  const city=params.get('city');
  if(city){
    document.getElementById('s-city').value=city;
    const coords=CITY_COORDS[city];
    if(coords) map.setView(coords,13);
  }
  if(window.location.hash==='#submit') openModal('submit-modal');
  renderList();
}

function initMiniMap() {
  if(miniMap){miniMap.remove();miniMap=null;miniMarker=null;}
  miniMap=L.map('mini-map',{zoomControl:false}).setView([20.5937,78.9629],4);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(miniMap);
  miniMap.on('click',e=>{
    pinLat=e.latlng.lat;pinLng=e.latlng.lng;
    if(miniMarker) miniMap.removeLayer(miniMarker);
    miniMarker=L.circleMarker([pinLat,pinLng],{radius:10,color:'#FF6B00',fillColor:'#FF6B00',fillOpacity:1}).addTo(miniMap);
    document.getElementById('pin-label').textContent=`Pin dropped at ${pinLat.toFixed(5)}, ${pinLng.toFixed(5)}`;
  });
  document.getElementById('f-city').addEventListener('change',function(){
    const c=CITY_COORDS[this.value];
    if(c){miniMap.setView(c,13);pinLat=c[0];pinLng=c[1];}
  });
}

function previewPhoto(e) {
  const file=e.target.files[0];if(!file) return;
  const reader=new FileReader();
  reader.onload=ev=>{
    document.getElementById('photo-preview-img').src=ev.target.result;
    document.getElementById('photo-preview-img').style.display='block';
    document.getElementById('upload-placeholder').style.display='none';
    document.getElementById('upload-area').classList.add('has-file');
  };
  reader.readAsDataURL(file);
}

async function submitSpot() {
  const name=document.getElementById('f-name').value.trim();
  const cat=document.getElementById('f-cat').value;
  const city=document.getElementById('f-city').value;
  if(!name||!cat||!city){showToast('Fill in name, category and city first');return;}
  const lat=pinLat||(CITY_COORDS[city]?CITY_COORDS[city][0]:20.5937);
  const lng=pinLng||(CITY_COORDS[city]?CITY_COORDS[city][1]:78.9629);
  let photo_url=null;
  const photoFile=document.getElementById('f-photo').files[0];
  if(photoFile){
    const ext=photoFile.name.split('.').pop();
    const fn=`${Date.now()}_${Math.random().toString(36).slice(2)}.${ext}`;
    const {error:ue}=await sb.storage.from(STORAGE_BUCKET).upload(fn,photoFile,{contentType:photoFile.type});
    if(!ue){
      const {data:ud}=sb.storage.from(STORAGE_BUCKET).getPublicUrl(fn);
      photo_url=ud.publicUrl;
    }
  }
  const {error}=await sb.from('spots').insert([{
    name,category:cat,city,
    address:document.getElementById('f-address').value.trim(),
    tip:document.getElementById('f-tip').value.trim(),
    phone:document.getElementById('f-phone').value.trim(),
    submitted_by:document.getElementById('f-by').value.trim(),
    lat,lng,photo_url
  }]);
  if(error){showToast('Something went wrong, try again');console.error(error);return;}
  document.getElementById('submit-form-wrap').style.display='none';
  document.getElementById('submit-success').style.display='block';
}

function openModal(id) {
  document.getElementById(id).classList.add('open');
  document.body.style.overflow='hidden';
  if(id==='submit-modal'){
    document.getElementById('submit-form-wrap').style.display='block';
    document.getElementById('submit-success').style.display='none';
    document.getElementById('photo-preview-img').style.display='none';
    document.getElementById('upload-placeholder').style.display='block';
    document.getElementById('upload-area').classList.remove('has-file');
    pinLat=null;pinLng=null;
    document.getElementById('pin-label').textContent='No pin dropped yet';
    setTimeout(initMiniMap,120);
  }
}
function closeModal(id){document.getElementById(id).classList.remove('open');document.body.style.overflow='';}
function overlayClose(e,id){if(e.target===document.getElementById(id)) closeModal(id);}
function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg;t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),3000);
}

document.addEventListener('DOMContentLoaded',()=>{initMap();loadSpots();});
</script>
</body>
</html>
